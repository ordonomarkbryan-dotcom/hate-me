# Upstash Redis credentials for response storage
# Get these from https://console.upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin secret key for viewing responses (set your own secure password)
ADMIN_SECRET=your-secret-admin-key-change-this

# Optional: Site URL for CORS (auto-detected on Vercel)
NEXT_PUBLIC_SITE_URL=
